{
	"$schema": "https://opencode.ai/config.json",
	"permission": {
		"bash": {
			"npm run *": "allow",
			"npx prisma *": "allow"
		}
	},
	"mcp": {
		"prisma": {
			"type": "remote",
			"url": "https://mcp.prisma.io/mcp",
			"enabled": false
		},
		"figma": {
			"type": "local",
			"command": [
				"cmd",
				"/c",
				"npx",
				"-y",
				"figma-developer-mcp",
				"--figma-api-key=${FIGMA_API_KEY}",
				"--stdio"
			],
			"enabled": false
		}
	}
}